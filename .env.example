# Database (PostgreSQL - Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgres://user:password@host:5432/database

# S3-Compatible Storage (Vercel Blob, Cloudflare R2 via S3 API, AWS S3, MinIO)
S3_ENDPOINT=https://your-endpoint
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_REGION=auto
S3_PUBLIC_URL=https://cdn.example.com

# Optional: Site URL for passkeys, CSRF, OAuth, sitemap, etc. (required behind TLS proxy)
# EMDASH_SITE_URL=https://your-site.vercel.app

# Optional: Additional origins for passkey verification (comma-separated)
# EMDASH_ALLOWED_ORIGINS=https://preview.your-site.vercel.app

# Optional: Encryption key for plugin secrets (generate with: npx emdash secrets generate)
# EMDASH_ENCRYPTION_KEY=your-32-byte-base64-key